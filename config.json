{
  "port": 5571,
  "serve_dir": "www",
  "spa_fallback_enabled": true,
  "gzip_enabled": true,
  "dashboard_enabled": true,
  "metrics_enabled": false,
  "https_enabled": false,
  "https_port": 5572,
  "watch_debounce_ms": 100,
  "watch_exclude_dirs": ["node_modules", ".git", "dist", "vendor"],
  "api_token": "troque-por-token-secreto",
  "api_command_enabled": false,
  "api_command_allow_list": ["npm", "git", "make", "php", "python3"],

  "fastcgi": {
    "enabled": false,
    "address": "127.0.0.1:9000",
    "extensions": [".php"],
    "root": "",
    "auto_start": false
  },

  "rate_limit": {
    "enabled": false,
    "requests_per_minute": 120,
    "burst_size": 20
  },

  "dns": {
    "enabled": false,
    "port": 5353,
    "domains": ["*.localhost", "*.dev.local"],
    "upstream": "8.8.8.8:53"
  },

  "processes": [
    {
      "name": "meu-backend",
      "command": "node",
      "args": ["server.js"],
      "dir": "./backend",
      "auto_start": false,
      "auto_restart": true,
      "port": 3000
    }
  ],

  "extra_ports": [
    {
      "port": 3001,
      "dir": "./dist",
      "https": false
    }
  ],

  "hosts_entries": [
    {
      "ip": "127.0.0.1",
      "domain": "meusite.local"
    }
  ],

  "proxy_rules": [
    {
      "path": "/api/",
      "target": "http://localhost:3000",
      "websocket_enabled": false
    }
  ],

  "virtual_hosts": [
    {
      "host": "projeto-a.localhost",
      "serve_dir": "./projetos/a",
      "spa_fallback": true,
      "runtime": "static"
    },
    {
      "host": "projeto-b.localhost",
      "serve_dir": "./projetos/b",
      "spa_fallback": false,
      "runtime": "php"
    }
  ],

  "mock_routes": [
    {
      "path": "/api/user",
      "method": "GET",
      "body": "{\"id\":1,\"name\":\"Henrique\",\"email\":\"dev@brhttp.dev\"}",
      "status_code": 200,
      "delay_ms": 0
    }
  ],

  "custom_headers": [
    {
      "path": "/api/",
      "headers": {
        "X-Powered-By": "brhttp/4.0",
        "X-Content-Type-Options": "nosniff"
      }
    }
  ],

  "redirects": [],
  "rewrites": [],

  "command_webhooks": [
    {
      "event": "server_start",
      "command": "echo",
      "args": ["brhttp v4 iniciado na porta {{port}}"]
    }
  ]
}