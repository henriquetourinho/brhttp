{
  "port": 5571,
  "serve_dir": "www",
  "spa_fallback_enabled": true,
  "gzip_enabled": true,
  "dashboard_enabled": true,
  "metrics_enabled": false,
  "https_enabled": false,
  "https_port": 5572,
  "watch_debounce_ms": 100,
  "watch_exclude_dirs": [
    "node_modules",
    ".git",
    "dist",
    "vendor"
  ],
  "api_token": "troque-por-token-secreto",
  "api_command_enabled": false,
  "api_command_allow_list": [
    "npm",
    "git",
    "make",
    "php",
    "python3"
  ],
  "basic_auth": {
    "enabled": false,
    "username": "admin",
    "password": "senha-segura",
    "realm": "brhttp"
  },
  "vhost_log_dir": "",
  "fastcgi": {
    "enabled": false,
    "address": "127.0.0.1:9000",
    "extensions": [
      ".php"
    ],
    "root": "",
    "auto_start": false
  },
  "rate_limit": {
    "enabled": false,
    "requests_per_minute": 120,
    "burst_size": 20
  },
  "dns": {
    "enabled": false,
    "port": 5353,
    "domains": [
      "*.localhost",
      "*.dev.local"
    ],
    "upstream": "8.8.8.8:53"
  },
  "scheduler": {
    "enabled": false,
    "jobs": [
      {
        "name": "exemplo-backup",
        "cron": "0 2 * * *",
        "command": "bash",
        "args": [
          "./scripts/backup.sh"
        ],
        "dir": "./",
        "timeout_seconds": 300,
        "on_error": "notify",
        "enabled": false
      },
      {
        "name": "limpar-cache",
        "cron": "*/15 * * * *",
        "command": "echo",
        "args": [
          "cache limpo"
        ],
        "dir": "",
        "timeout_seconds": 30,
        "on_error": "log",
        "enabled": false
      }
    ]
  },
  "notifications": {
    "telegram": {
      "enabled": false,
      "bot_token": "SEU-BOT-TOKEN-AQUI",
      "chat_ids": [
        "SEU-CHAT-ID",
        "OUTRO-CHAT-ID"
      ]
    },
    "discord": {
      "enabled": false,
      "webhook_urls": [
        "https://discord.com/api/webhooks/SEU-WEBHOOK"
      ]
    }
  },
  "lets_encrypt": {
    "enabled": false,
    "domains": [
      "meusite.com",
      "www.meusite.com"
    ],
    "email": "seu@email.com",
    "staging": true,
    "cache_dir": "./.acme-certs"
  },
  "processes": [
    {
      "name": "meu-backend",
      "command": "node",
      "args": [
        "server.js"
      ],
      "dir": "./backend",
      "auto_start": false,
      "auto_restart": true,
      "port": 3000
    }
  ],
  "extra_ports": [
    {
      "port": 3001,
      "dir": "./dist",
      "https": false
    }
  ],
  "hosts_entries": [
    {
      "ip": "127.0.0.1",
      "domain": "meusite.local"
    }
  ],
  "proxy_rules": [
    {
      "path": "/api/",
      "target": "http://localhost:3000",
      "websocket_enabled": false
    }
  ],
  "virtual_hosts": [
    {
      "host": "projeto-a.localhost",
      "serve_dir": "./projetos/a",
      "spa_fallback": true,
      "runtime": "static"
    },
    {
      "host": "projeto-b.localhost",
      "serve_dir": "./projetos/b",
      "spa_fallback": false,
      "runtime": "php"
    }
  ],
  "mock_routes": [
    {
      "path": "/api/user",
      "method": "GET",
      "body": "{\"id\":1,\"name\":\"Henrique\",\"email\":\"dev@brhttp.dev\"}",
      "status_code": 200,
      "delay_ms": 0
    }
  ],
  "custom_headers": [
    {
      "path": "/api/",
      "headers": {
        "X-Powered-By": "brhttp/4.5",
        "X-Content-Type-Options": "nosniff"
      }
    }
  ],
  "redirects": [],
  "rewrites": [],
  "command_webhooks": [
    {
      "event": "server_start",
      "command": "echo",
      "args": [
        "brhttp v4.5 iniciado na porta {{port}}"
      ]
    }
  ]
}